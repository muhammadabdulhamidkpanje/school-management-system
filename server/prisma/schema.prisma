// ============================================================================
// School Management System - Prisma Schema
// ============================================================================
// This file is the canonical Prisma schema for the project.
// The modular schema files under prisma/schemas are kept as a reference,
// but Prisma reads this single file directly.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// CORE AUTH MODULE
// ============================================================================
// Core authentication and authorization models
// User accounts, roles, permissions, and access control

model User {
  id           String @id @default(uuid())
  email        String @unique
  passwordHash String

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  isActive   Boolean @default(true)
  isVerified Boolean @default(false)

  lastLogin DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile UserProfile?

  refreshTokens RefreshToken[]

  auditLogs AuditLog[]

  passwordResets PasswordReset[]

  emailVerifications EmailVerification[]

  notifications Notification[]

  students                     Student[]
  admissionInformationRequests AdmissionInformationRequest[]
  staff                        Staff?

  @@index([email])
}

model UserProfile {
  id String @id @default(uuid())

  userId String @unique

  firstName  String
  middleName String?
  lastName   String

  gender      String?
  phone       String?
  dateOfBirth DateTime?
  address     String?

  profileImage String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Role {
  id String @id @default(uuid())

  name        String  @unique
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  rolePermissions RolePermission[]

  @@index([name])
}

model Permission {
  id String @id @default(uuid())

  name        String  @unique
  description String?

  createdAt DateTime @default(now())

  rolePermissions RolePermission[]

  @@index([name])
}

model RolePermission {
  roleId       String
  permissionId String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

// ============================================================================
// AUTH SUPPORT MODULE
// ============================================================================
// Supporting models for authentication, security, and auditing
// Refresh tokens, password resets, audit logs, email verification

model RefreshToken {
  id String @id @default(uuid())

  token String @db.Text

  expiresAt DateTime

  revoked Boolean @default(false)

  createdAt DateTime @default(now())

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model PasswordReset {
  id String @id @default(uuid())

  token String

  expiresAt DateTime

  used Boolean @default(false)

  createdAt DateTime @default(now())

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model AuditLog {
  id String @id @default(uuid())

  action String

  tableName String?

  recordId String?

  ipAddress String?

  createdAt DateTime @default(now())

  userId String

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([tableName])
  @@index([createdAt])
}

model EmailVerification {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

// ============================================================================
// NOTIFICATIONS MODULE
// ============================================================================
// System notifications, alerts, and communication tracking

enum NotificationType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  ACCOUNT_ACTIVATED
  GENERAL
  ALERT
}

enum NotificationChannel {
  EMAIL
  IN_APP
  BOTH
}

model Notification {
  id        String              @id @default(uuid())
  userId    String
  title     String
  message   String
  type      NotificationType
  channel   NotificationChannel
  isRead    Boolean             @default(false)
  sentAt    DateTime?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

// ============================================================================
// ACADEMIC STRUCTURE MODULE
// ============================================================================
// Faculty, departments, sessions, semesters, classrooms, subjects, and courses
// Defines the organizational hierarchy of the academic system

model Faculty {
  id          String       @id @default(cuid())
  name        String
  code        String       @unique
  departments Department[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@map("faculties")
}

model Department {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  facultyId String?
  faculty   Faculty? @relation(fields: [facultyId], references: [id])

  subjects   Subject[]
  courses    Course[]
  classrooms Classroom[]
  staff      Staff[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@index([facultyId])
  @@map("departments")
}

model Session {
  id                        String   @id @default(cuid())
  name                      String   @unique
  startDate                 DateTime
  endDate                   DateTime
  isCurrent                 Boolean  @default(false)
  admissionsOpen            Boolean  @default(false)
  requiredAdmissionSubjects String[] @default(["English", "Mathematics"])

  semesters           Semester[]
  admissions          Admission[]
  enrollments         Enrollment[]
  availableClassrooms SessionClassroom[]
  academicCalendars  AcademicCalendar[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isCurrent])
  @@index([startDate])
  @@map("sessions")
}

model Semester {
  id        String   @id @default(cuid())
  name      String
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)

  enrollments     Enrollment[]
  courseOfferings CourseOffering[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([sessionId, name])
  @@index([sessionId])
  @@index([isCurrent])
  @@map("semesters")
}

model InstitutionProfile {
  id        String   @id @default("default")
  name      String
  email     String?
  address   String?
  phone     String?
  logoUrl   String?
  latitude  Float?
  longitude Float?
  updatedAt DateTime @updatedAt

  @@map("institution_profile")
}

model GradingSystem {
  id        String   @id @default(cuid())
  name      String   @unique
  grades    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("grading_systems")
}

model AcademicCalendar {
  id          String    @id @default(cuid())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  sessionId   String?
  session     Session?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([sessionId])
  @@index([startDate])
  @@map("academic_calendars")
}

model Classroom {
  id             String      @id @default(cuid())
  name           String
  level          String
  capacity       Int?
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id])
  classTeacherId String?
  isActive       Boolean     @default(true)

  students            Student[]
  requestedAdmissions Admission[]         @relation("AdmissionRequestedClass")
  approvedAdmissions  Admission[]         @relation("AdmissionApprovedClass")
  enrollments         Enrollment[]
  courseOfferings     CourseOffering[]
  attendanceSessions  AttendanceSession[]
  availableInSessions SessionClassroom[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name])
  @@index([level])
  @@index([departmentId])
  @@map("classrooms")
}

model Subject {
  id           String      @id @default(cuid())
  name         String
  code         String      @unique
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  courseOfferings CourseOffering[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@index([departmentId])
  @@map("subjects")
}

model Course {
  id           String      @id @default(cuid())
  name         String
  code         String      @unique
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  courseOfferings CourseOffering[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@index([departmentId])
  @@map("courses")
}

// ============================================================================
// COURSE DELIVERY MODULE
// ============================================================================
// Course offerings, attendance tracking, and staff management
// Represents actual course instances, attendance sessions, and instructor details

model Staff {
  id             String               @id @default(cuid())
  employeeNo     String               @unique
  firstName      String
  lastName       String
  email          String?              @unique
  phone          String?
  designation    String?
  employmentType String?
  employmentDate DateTime?
  isActive       Boolean              @default(true)
  userId         String?              @unique
  user           User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  departmentId   String?
  department     Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  qualifications StaffQualification[]
  privateData    StaffPrivateData?

  courseOfferings CourseOffering[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeNo])
  @@index([email])
  @@index([isActive])
  @@index([departmentId])
  @@index([userId])
  @@map("staff")
}

model StaffQualification {
  id                   String   @id @default(cuid())
  staffId              String
  staff                Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  level                String
  institution          String
  qualification        String
  year                 Int
  documentPublicId     String?
  documentFileName     String?
  documentMimeType     String?
  documentFileSize     Int?
  documentResourceType String?
  createdAt            DateTime @default(now())

  @@index([staffId])
}

model StaffPrivateData {
  staffId              String @id
  staff                Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  encryptedBankDetails String @db.Text
}

model CourseOffering {
  id                 String              @id @default(cuid())
  courseId           String?
  course             Course?             @relation(fields: [courseId], references: [id])
  subjectId          String?
  subject            Subject?            @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  classroomId        String
  classroom          Classroom           @relation(fields: [classroomId], references: [id])
  semesterId         String
  semester           Semester            @relation(fields: [semesterId], references: [id])
  teacherId          String?
  teacher            Staff?              @relation(fields: [teacherId], references: [id])
  attendanceSessions AttendanceSession[]
  assessments        Assessment[]
  exams              Exam[]
  creditUnit         Int                 @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, classroomId, semesterId])
  @@unique([subjectId, classroomId, semesterId])
  @@index([courseId])
  @@index([subjectId])
  @@index([classroomId])
  @@index([semesterId])
  @@index([teacherId])
  @@map("course_offerings")
}

model AttendanceSession {
  id               String          @id @default(cuid())
  classroomId      String
  classroom        Classroom       @relation(fields: [classroomId], references: [id])
  courseOfferingId String?
  courseOffering   CourseOffering? @relation(fields: [courseOfferingId], references: [id])
  sessionDate      DateTime
  topic            String?

  records   AttendanceRecord[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([classroomId, sessionDate])
  @@index([courseOfferingId])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id                  String            @id @default(cuid())
  attendanceSessionId String
  attendanceSession   AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)
  studentId           String
  student             Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  present             Boolean           @default(false)
  note                String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([attendanceSessionId, studentId])
  @@index([studentId])
  @@index([attendanceSessionId])
  @@map("attendance_records")
}

// ============================================================================
// STUDENT MANAGEMENT MODULE
// ============================================================================
// Student records, enrollments, admissions, guardians, and academic profiles
// Manages student lifecycle from admission through enrollment and graduation

enum StudentStatus {
  ACTIVE
  GRADUATED
  WITHDRAWN
  SUSPENDED
}

enum AdmissionStatus {
  PENDING
  UNDER_REVIEW
  MORE_INFORMATION_REQUIRED
  APPROVED
  REJECTED
  WITHDRAWN
  ENROLLED
}

enum AdmissionInformationRequestType {
  DOCUMENT
  PERSONAL_INFORMATION
  ACADEMIC_INFORMATION
  ACADEMIC_RESULT
  CORRECTION
  OTHER
}

enum AdmissionInformationRequestStatus {
  OPEN
  SUBMITTED
  RESOLVED
  CANCELLED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  WITHDRAWN
}

enum GuardianRelationship {
  FATHER
  MOTHER
  SIBLING
  UNCLE
  AUNT
  GRANDPARENT
  LEGAL_GUARDIAN
  OTHER
}

model Student {
  id          String  @id @default(cuid())
  admissionNo String  @unique
  userId      String? @unique
  user        User?   @relation(fields: [userId], references: [id])

  firstName  String
  lastName   String
  middleName String?
  dob        DateTime
  gender     String

  classroomId String?
  classroom   Classroom? @relation(fields: [classroomId], references: [id])

  admissionDate DateTime      @default(now())
  status        StudentStatus @default(ACTIVE)

  admission         Admission?
  enrollments       Enrollment[]
  guardians         StudentGuardian[]
  academicProfile   StudentAcademicProfile?
  attendanceRecords AttendanceRecord[]
  scores            StudentScore[]
  invoices          FeeInvoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([admissionNo])
  @@index([userId])
  @@index([classroomId])
  @@index([status])
  @@map("students")
}

model StudentAcademicProfile {
  id             String  @id @default(cuid())
  studentId      String  @unique
  student        Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  currentLevel   String?
  admissionYear  Int?
  previousSchool String?
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@map("student_academic_profiles")
}

model Admission {
  id               String     @id @default(cuid())
  studentId        String?    @unique
  student          Student?   @relation(fields: [studentId], references: [id])
  sessionId        String?
  session          Session?   @relation(fields: [sessionId], references: [id])
  classroomId      String?
  requestedClassId String?
  requestedClass   Classroom? @relation("AdmissionRequestedClass", fields: [requestedClassId], references: [id], onDelete: SetNull)

  applicantFirstName  String
  applicantMiddleName String?
  applicantLastName   String
  email               String?
  applicantPhone      String?
  dateOfBirth         DateTime?
  gender              String?
  nationality         String?
  state               String?
  lga                 String?
  religion            String?
  applicationNumber   String?                       @unique
  applicantTokenHash  String?                       @unique
  approvedClassId     String?
  approvedClass       Classroom?                    @relation("AdmissionApprovedClass", fields: [approvedClassId], references: [id], onDelete: SetNull)
  applicationDate     DateTime                      @default(now())
  status              AdmissionStatus               @default(PENDING)
  reviewedById        String?
  reviewedAt          DateTime?
  remarks             String?
  results             AdmissionResult[]
  uploadedDocuments   AdmissionDocument[]
  informationRequests AdmissionInformationRequest[]
  statusHistory       AdmissionStatusHistory[]
  enrollment          Enrollment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([sessionId])
  @@index([requestedClassId])
  @@index([approvedClassId])
  @@index([email])
  @@index([status])
  @@index([applicationDate])
  @@map("admissions")
}

model SessionClassroom {
  sessionId   String
  session     Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@id([sessionId, classroomId])
  @@index([classroomId])
  @@map("session_classrooms")
}

model AdmissionResult {
  id          String    @id @default(cuid())
  admissionId String
  admission   Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  subject     String
  grade       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([admissionId, subject])
  @@index([admissionId])
  @@map("admission_results")
}

model AdmissionDocument {
  id                   String                       @id @default(cuid())
  admissionId          String
  admission            Admission                    @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  documentType         String
  fileName             String
  fileUrl              String
  mimeType             String
  fileSize             Int
  publicId             String?                      @unique
  resourceType         String?
  informationRequestId String?
  informationRequest   AdmissionInformationRequest? @relation(fields: [informationRequestId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([admissionId])
  @@index([documentType])
  @@map("admission_documents")
}

model AdmissionInformationRequest {
  id            String                            @id @default(cuid())
  admissionId   String
  admission     Admission                         @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy   User                              @relation(fields: [requestedById], references: [id])
  type          AdmissionInformationRequestType
  field         String?
  documentType  String?
  message       String
  status        AdmissionInformationRequestStatus @default(OPEN)
  response      String?
  resolvedAt    DateTime?
  createdAt     DateTime                          @default(now())
  updatedAt     DateTime                          @updatedAt
  documents     AdmissionDocument[]

  @@index([admissionId, status])
  @@index([requestedById])
  @@map("admission_information_requests")
}

model AdmissionStatusHistory {
  id          String           @id @default(cuid())
  admissionId String
  admission   Admission        @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  oldStatus   AdmissionStatus?
  newStatus   AdmissionStatus
  reason      String?
  changedBy   String?
  createdAt   DateTime         @default(now())

  @@index([admissionId, createdAt])
  @@index([changedBy])
  @@map("admission_status_history")
}

model Enrollment {
  id          String           @id @default(cuid())
  admissionId String?          @unique
  admission   Admission?       @relation(fields: [admissionId], references: [id], onDelete: SetNull)
  studentId   String
  student     Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classroomId String
  classroom   Classroom        @relation(fields: [classroomId], references: [id])
  sessionId   String
  session     Session          @relation(fields: [sessionId], references: [id])
  semesterId  String?
  semester    Semester?        @relation(fields: [semesterId], references: [id])
  status      EnrollmentStatus @default(ACTIVE)
  enrolledAt  DateTime         @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, sessionId, classroomId])
  @@index([studentId])
  @@index([classroomId])
  @@index([sessionId])
  @@index([status])
  @@map("enrollments")
}

model Guardian {
  id         String  @id @default(cuid())
  firstName  String
  lastName   String
  phone      String
  email      String?
  address    String?
  occupation String?

  students StudentGuardian[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
  @@index([email])
  @@map("guardians")
}

model StudentGuardian {
  studentId    String
  student      Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardianId   String
  guardian     Guardian             @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  relationship GuardianRelationship
  isPrimary    Boolean              @default(false)

  createdAt DateTime @default(now())

  @@id([studentId, guardianId])
  @@index([studentId])
  @@index([guardianId])
  @@map("student_guardians")
}

// ============================================================================
// RESULTS MODULE
// ============================================================================
// Academic assessment and examination setup for course offerings.

enum AssessmentType {
  TEST
  QUIZ
  ASSIGNMENT
  PROJECT
  EXAM
  PRESENTATION
  OTHER
}

enum ExamType {
  QUIZ
  MIDTERM
  FINAL
  PRACTICAL
  ORAL
  OTHER
}

model Assessment {
  id               String         @id @default(cuid())
  courseOfferingId String
  courseOffering   CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  title            String
  type             AssessmentType @default(TEST)
  weight           Int            @default(0)
  maxMarks         Int            @default(100)
  dueDate          DateTime?
  isPublished      Boolean        @default(false)
  scores           StudentScore[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseOfferingId, title])
  @@index([courseOfferingId])
  @@index([type])
  @@map("assessments")
}

model Exam {
  id               String         @id @default(cuid())
  courseOfferingId String
  courseOffering   CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  title            String
  examType         ExamType       @default(FINAL)
  date             DateTime
  durationMinutes  Int            @default(60)
  totalMarks       Int            @default(100)
  venue            String?
  isPublished      Boolean        @default(false)
  scores           StudentScore[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseOfferingId, title])
  @@index([courseOfferingId])
  @@index([examType])
  @@map("exams")
}

model StudentScore {
  id           String      @id @default(cuid())
  studentId    String
  student      Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assessmentId String?
  assessment   Assessment? @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  examId       String?
  exam         Exam?       @relation(fields: [examId], references: [id], onDelete: Cascade)
  marks        Float
  remarks      String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([studentId, assessmentId])
  @@unique([studentId, examId])
  @@index([studentId])
  @@index([assessmentId])
  @@index([examId])
  @@map("student_scores")
}

enum FeeInvoiceStatus {
  ISSUED
  PARTIALLY_PAID
  PAID
  WAIVED
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  MOBILE_MONEY
}

model Fee {
  id          String       @id @default(cuid())
  name        String
  code        String       @unique
  amount      Decimal      @db.Decimal(12, 2)
  currency    String       @default("NGN")
  description String?
  isActive    Boolean      @default(true)
  invoices    FeeInvoice[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([isActive])
  @@map("fees")
}

model FeeInvoice {
  id        String           @id @default(cuid())
  studentId String
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeId     String
  fee       Fee              @relation(fields: [feeId], references: [id])
  amount    Decimal          @db.Decimal(12, 2)
  dueDate   DateTime?
  status    FeeInvoiceStatus @default(ISSUED)
  payments  FeePayment[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([studentId, feeId])
  @@index([studentId, status])
  @@map("fee_invoices")
}

model FeePayment {
  id        String        @id @default(cuid())
  invoiceId String
  invoice   FeeInvoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Decimal       @db.Decimal(12, 2)
  method    PaymentMethod
  reference String?       @unique
  paidAt    DateTime      @default(now())
  createdAt DateTime      @default(now())

  @@index([invoiceId, paidAt])
  @@map("fee_payments")
}
